[Unit]
Description=NoxL Desktop Session
Documentation=https://github.com/Noxaryn/NoxL
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service

[Service]
Type=idle
# Launch the NoxL shell, which starts the compositor and desktop components.
ExecStart=/usr/bin/noxl-shell
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target